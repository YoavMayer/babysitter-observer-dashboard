{
  "name": "@a5c-ai/babysitter-observer",
  "version": "0.1.0-alpha.0",
  "description": "Real-time observability dashboard for babysitter orchestration runs",
  "private": false,
  "license": "MIT",
  "bin": {
    "babysitter-observer": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoavMayer/babysitter-observer-dashboard.git"
  },
  "homepage": "https://github.com/YoavMayer/babysitter-observer-dashboard#readme",
  "bugs": {
    "url": "https://github.com/YoavMayer/babysitter-observer-dashboard/issues"
  },
  "keywords": [
    "babysitter",
    "observer",
    "dashboard",
    "orchestration",
    "monitoring",
    "nextjs",
    "sse",
    "real-time"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    ".next/server",
    ".next/static",
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/package.json",
    "public",
    "next.config.mjs",
    "postcss.config.mjs",
    "tsconfig.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:cli": "npx ts-node --skip-project src/cli.ts",
    "build": "next build",
    "build:cli": "node -e \"require('esbuild').buildSync({entryPoints:['src/cli.ts'],bundle:true,platform:'node',target:'node18',outfile:'dist/cli.js',external:['next'],banner:{js:'#!/usr/bin/env node'}})\"",
    "start": "next start --port 3000",
    "lint": "next lint",
    "prepublishOnly": "npm run build && npm run build:cli",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.0.5",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "next": "14.2.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "esbuild": "^0.21.5",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "jsdom": "^24.1.3",
    "msw": "^2.12.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
